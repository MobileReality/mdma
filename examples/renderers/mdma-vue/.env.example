# OpenRouter API key — https://openrouter.ai/keys
# Copy this file to .env and fill in your key, then restart `pnpm dev`.
# NOTE: with a Vite VITE_ variable the key is bundled into the browser build.
# That's fine for a local demo; a production app must proxy OpenRouter through a
# backend so the key never reaches the client (see the ag-ui example).
VITE_OPENROUTER_API_KEY=

# Optional — any OpenRouter model slug. Defaults to openai/gpt-5.6-luna.
# VITE_MDMA_MODEL=openai/gpt-5.6-luna
