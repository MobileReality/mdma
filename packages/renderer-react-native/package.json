{
  "name": "@mobile-reality/mdma-renderer-react-native",
  "version": "0.2.0",
  "keywords": [
    "mdma",
    "markdown",
    "ai",
    "llm",
    "interactive-document",
    "react-native",
    "ios",
    "android",
    "forms",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
