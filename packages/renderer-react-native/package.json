    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-native": "^0.76.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MobileReality/mdma.git",
    "directory": "packages/renderer-react-native"
