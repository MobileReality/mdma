{
  "name": "@mobile-reality/mdma-mcp",
  "version": "0.3.0",
  "keywords": [
    "mdma",
    "markdown",
    "ai",
    "llm",
    "interactive-document",
    "mcp",
    "model-context-protocol",
    "claude"
  ],
  "mcpName": "io.github.MobileReality/mdma",
  "type": "module",
  "bin": {
    "mdma-mcp": "./dist/bin/mdma-mcp.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "lint": "biome lint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mobile-reality/mdma-spec": "workspace:*",
    "@mobile-reality/mdma-prompt-pack": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MobileReality/mdma.git",
    "directory": "packages/mcp"
  }
}
